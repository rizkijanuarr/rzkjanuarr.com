---
const socials = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/rzkjanuarr/" },
  { label: "GitHub", href: "https://github.com/rzkjanuarr" },
  { label: "WhatsApp", href: "http://wa.me/6285749463854" },
];
---

<footer class="footer" id="contact">
  <div class="container">
    <div class="footer-cta">
      <h2 class="footer-title">Let&apos;s build something together.</h2>
    </div>

    <div class="footer-grid">
      <div class="footer-col">
        <div class="brand">
          <span class="brand-badge">R</span>
          <span class="brand-name">RIZKI</span>
        </div>
        <p class="footer-about">
          I help teams design and build digital products with a practical,
          scalable, and user-focused engineering approach.
        </p>
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Contact</h3>
        <a class="footer-link" href="http://wa.me/6285749463854">+62 857 4946 3854</a>
        <a class="footer-link" href="mailto:rizkijanuar.work@gmail.com"
          >rizkijanuar.work@gmail.com</a
        >
        <a
          class="footer-link"
          href="https://rzkjanuarr-com.vercel.app/"
          target="_blank"
          rel="noreferrer">www.rzkjanuarr.com</a
        >
      </div>

      <div class="footer-col">
        <h3 class="footer-heading">Socials</h3>
        {
          socials.map((s) => (
            <a
              class="footer-link"
              href={s.href}
              target="_blank"
              rel="noreferrer"
            >
              {s.label} ↗
            </a>
          ))
        }
      </div>
    </div>

    <div class="footer-bottom">
      <span>Copyright © 2026 Rizki Januar Irmansyah. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 40px;
    background: var(--purple);
    border-top: var(--border-thick);
    padding-block: 56px;
  }

  .footer-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    background: var(--white);
    border: var(--border-thick);
    box-shadow: var(--shadow);
    padding: 30px 34px;
  }

  .footer-title {
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: 800;
    line-height: 1.1;
    max-width: 560px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 30px;
    margin-top: 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.3rem;
    margin-bottom: 14px;
  }

  .brand-badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--orange);
    border: var(--border);
    box-shadow: var(--shadow-sm);
  }

  .footer-about {
    font-weight: 500;
    max-width: 340px;
  }

  .footer-heading {
    font-weight: 800;
    margin-bottom: 14px;
    background: var(--ink);
    color: var(--white);
    display: inline-block;
    padding: 4px 12px;
  }

  .footer-link {
    display: block;
    font-weight: 600;
    padding: 5px 0;
    width: fit-content;
    border-bottom: 3px solid transparent;
    transition: border-color 0.08s ease;
  }

  .footer-link:hover {
    border-bottom: 3px solid var(--ink);
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 22px;
    border-top: var(--border);
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-col {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .brand {
      justify-content: center;
    }

    .footer-about {
      max-width: none;
    }

    .footer-link {
      width: auto;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-cta {
      justify-content: center;
      text-align: center;
    }
  }
</style>
