---
const stats = [
  { num: "2+", label: "Years Experience" },
  { num: "19+", label: "Projects Shipped" },
  { num: "3", label: "Companies" },
];
---

<section class="hero section" id="home">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="hero-tag">hi, I&apos;m Rizki!</span>
      <h1 class="hero-title">
        MOBILE<br />
        <span class="hl">DEVELOPER</span>
      </h1>
      <p class="hero-desc">
        I build scalable services and production-ready mobile apps
        with focus on reliability, performance, and clean engineering.
      </p>
      <div class="hero-actions">
        <a class="btn btn-green" href="#projects">See my work ↓</a>
      </div>
    </div>

    <div class="hero-figure">
      <div class="photo-frame">
        <img
          src="/images/hero-image.png"
          alt="Rizki - Mobile Developer"
          width="500"
          height="700"
        />
      </div>
      <div class="badge-sticker">MOBILE DEV</div>
    </div>
  </div>

  <div class="container">
    <div class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 56px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 46px;
    align-items: center;
  }

  .hero-tag {
    display: inline-block;
    background: var(--green);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    font-weight: 700;
    padding: 8px 16px;
    margin-bottom: 22px;
  }

  .hero-title {
    font-size: clamp(2.6rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .hero-title .hl {
    background: var(--yellow);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    padding: 0 10px;
    display: inline-block;
  }

  .hero-desc {
    margin-top: 24px;
    max-width: 460px;
    font-size: 1.08rem;
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .hero-figure {
    position: relative;
  }

  .photo-frame {
    border: var(--border-thick);
    box-shadow: var(--shadow-lg);
    background: var(--white);
    overflow: hidden;
  }

  .photo-frame img {
    width: 100%;
    height: auto;
  }

  .badge-sticker {
    position: absolute;
    bottom: -18px;
    left: -18px;
    background: var(--yellow);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    font-weight: 800;
    padding: 12px 18px;
    transform: rotate(-6deg);
    letter-spacing: 0.05em;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-top: 60px;
    border: var(--border-thick);
    box-shadow: var(--shadow);
    background: var(--white);
  }

  .stat {
    padding: 26px 20px;
    text-align: center;
  }

  .stat + .stat {
    border-left: var(--border);
  }

  .stat-num {
    display: block;
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
  }

  .stat-label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }
    .badge-sticker {
      left: auto;
      right: -10px;
    }
    .stats {
      grid-template-columns: 1fr;
    }
    .stat + .stat {
      border-left: none;
      border-top: var(--border);
    }
  }
</style>
