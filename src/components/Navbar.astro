---
const links = [
  { href: "#home", label: "Home" },
  { href: "#work", label: "Work" },
  { href: "#education", label: "Education" },
  { href: "#skills", label: "Skills" },
  { href: "#projects", label: "Projects" },
];
---

<header class="nav">
  <div class="nav-inner container">
    <a class="brand" href="#home">
      <span class="brand-badge">R</span>
      <span class="brand-name">RIZKI</span>
    </a>

    <nav class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a
      class="btn btn-yellow nav-cta"
      href="https://docs.google.com/document/d/1l0JXRqzWRrhK_46NVYhZpQBieQJiJ3ysQz6AGv0x_uE/edit?usp=sharing"
      target="_blank"
      rel="noreferrer"
    >
      Resume ↗
    </a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    border-bottom: var(--border-thick);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-block: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
  }

  .brand-badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--orange);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    font-size: 1.2rem;
  }

  .nav-links {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .nav-links a {
    font-weight: 700;
    padding: 8px 14px;
    border: 3px solid transparent;
    transition:
      transform 0.08s ease,
      border-color 0.08s ease,
      background 0.08s ease;
  }

  .nav-links a:hover {
    border: var(--border);
    background: var(--yellow);
    transform: translate(-1px, -1px);
  }

  .nav-cta {
    padding: 9px 16px;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
  }
</style>
